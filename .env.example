# Copy to .env, replace both placeholders, and keep .env private.
POSTGRES_DB=vehicle
POSTGRES_USER=vehicle
POSTGRES_PASSWORD=1
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
DB_HOST=localhost
DB_PORT=5433
SERVER_PORT=9001
FRONTEND_PORT=3000
POSTGRES_PORT=5433
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
LOKI_PORT=3100
# Relative to sv_vehicle when launched there; Compose mount is relative to repo root.
APP_LOG_FILE=./logs/sv_vehicle.json
APP_LOG_DIR=./backend/services/sv_vehicle/logs
TRACING_SAMPLE_RATE=1.0
OTLP_HTTP_PORT=4318
TEMPO_PORT=3200
TEMPO_RETENTION=24h
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
SPAN_LOGS_ENABLED=true
