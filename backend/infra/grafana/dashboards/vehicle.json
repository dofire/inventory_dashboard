          "refId": "A",
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"sv_vehicle\",uri!~\"/actuator.*\",status=~\"5..\"}[$__rate_interval])) / clamp_min(sum(rate(http_server_requests_seconds_count{job=\"sv_vehicle\",uri!~\"/actuator.*\"}[$__rate_interval])), 0.000001)",
          "legendFormat": "5xx rate"
