{
  "uid": "sv-vehicle",
  "title": "Vehicle API performance",
  "schemaVersion": 39,
  "version": 7,
  "refresh": "15s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "tags": [
    "vehicle",
    "api"
  ],
  "panels": [
    {
      "id": 1,
      "title": "Total requests",
      "description": "Requests during the time window set in the Grafana time picker.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(increase(http_server_requests_seconds_count{job=\"sv_vehicle\",uri!~\"/actuator.*\"}[$__range])) or vector(0)",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value"
      }
    },
    {
      "id": 2,
      "title": "Success",
      "description": "Requests during the time window set in the Grafana time picker.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(increase(http_server_requests_seconds_count{job=\"sv_vehicle\",uri!~\"/actuator.*\",status=~\"[23]..\"}[$__range])) or vector(0)",
