    {
      "id": 4,
      "title": "Requests per second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 14,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"sv_vehicle\",uri!~\"/actuator.*\"}[$__rate_interval]))",
          "legendFormat": "RPS"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Request outcomes",
      "type": "piechart",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 14,
        "y": 4,
        "w": 10,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(http_server_requests_seconds_count{job=\"sv_vehicle\",uri!~\"/actuator.*\",status=~\"[23]..\"}[$__range])) or vector(0)",
          "legendFormat": "Success",
          "instant": true,
          "range": false
        },
        {
          "refId": "B",
          "expr": "sum(increase(http_server_requests_seconds_count{job=\"sv_vehicle\",uri!~\"/actuator.*\",status=~\"4..\"}[$__range])) or vector(0)",
          "legendFormat": "Client error",
          "instant": true,
          "range": false
        },
        {
          "refId": "C",
          "expr": "sum(increase(http_server_requests_seconds_count{job=\"sv_vehicle\",uri!~\"/actuator.*\",status=~\"5..\"}[$__range])) or vector(0)",
          "legendFormat": "Server error",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "pieType": "donut",
        "displayLabels": [
          "percent"
        ],
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        },
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": [
            "value",
            "percent"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Success"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Client error"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Server error"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 6,
      "title": "GET vehicles",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 7,
      "title": "P95 execution time",
      "description": "Full HTTP request duration and API business logic duration. Business logic comes from Tempo spans; full request duration comes from HTTP metrics. Sampling affects span data. Named child steps and repository spans are included only for this API via inherited api.operation.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"sv_vehicle\",uri=\"/vehicles\"}[$__rate_interval])))",
          "legendFormat": "Full request",
          "exemplar": true
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le, operation) (rate(traces_spanmetrics_latency_bucket{service=\"sv_vehicle\",span_name=\"business.logic\",operation=\"GetVehiclesService.findVehicles\"}[$__rate_interval])))",
          "legendFormat": "{{operation}}",
          "exemplar": true
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.95, sum by (le, span_name, operation) (rate(traces_spanmetrics_latency_bucket{service=\"sv_vehicle\",api_operation=\"GetVehiclesService.findVehicles\",span_name!=\"business.logic\"}[$__rate_interval])))",
          "legendFormat": "{{span_name}} \u00b7 {{operation}}",
          "exemplar": true
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "A"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "B"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      }
    },
