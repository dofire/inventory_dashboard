local.file_match "vehicle" {
  path_targets = [{ "__path__" = "/var/log/sv_vehicle/*.json", "app" = "sv_vehicle" }]
}

loki.source.file "vehicle" {
  targets    = local.file_match.vehicle.targets
  forward_to = [loki.process.vehicle.receiver]
}

loki.process "vehicle" {
  stage.json {
    expressions = { timestamp = "\"@timestamp\"", level = "level" }
  }
  stage.timestamp {
    source = "timestamp"
    format = "RFC3339Nano"
  }
  stage.labels {
    values = { level = "" }
  }
  // traceId/spanId stay in the JSON body; never index them as labels.
  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

// Spring Boot -> OTLP/HTTP -> bounded batch -> Tempo OTLP/gRPC.
otelcol.receiver.otlp "vehicle" {
  http {
    endpoint = "0.0.0.0:4318"
  }
  output {
    traces = [otelcol.processor.memory_limiter.traces.input]
  }
}

otelcol.processor.memory_limiter "traces" {
  check_interval = "1s"
  limit = "128MiB"
  spike_limit = "32MiB"
  output {
    traces = [otelcol.processor.batch.traces.input]
  }
}

otelcol.processor.batch "traces" {
  timeout = "1s"
  send_batch_size = 256
  send_batch_max_size = 512
  output {
    traces = [otelcol.exporter.otlp.tempo.input]
  }
}

otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "tempo:4317"
    tls {
      insecure = true
    }
  }
}
