# Run requests with IntelliJ HTTP Client or the VS Code REST Client extension.
# Start from the repository root: ./tools/run-local.sh
# Random UUID per request: IntelliJ uses {{$uuid}}; VS Code REST Client uses {{$guid}}.
# For VS Code, replace $uuid with $guid in the headers below.
@baseUrl = http://localhost:9001
@dealershipId = DEALER_HCM_001
@vehicleId = 00000000-0000-0000-0000-000000000001
@userId = 00000000-0000-0000-0000-000000000100
# Copy the selected vehicle's current rowVersion from GET /vehicles before updating.
# A freshly started server seeds all vehicles with rowVersion 0.
@rowVersion = 0

### List inventory (200; up to 20 vehicles)
GET {{baseUrl}}/vehicles?dealershipId={{dealershipId}}&page=0&size=20
X-Request-ID: {{$uuid}}
Accept: application/json

### Filter by make, model, minimum age, and aging stock (200)
GET {{baseUrl}}/vehicles?dealershipId={{dealershipId}}&make=Toyota&model=Corolla&age=90&aging=true&page=0&size=10
X-Request-ID: {{$uuid}}
Accept: application/json

### Filter multiple makes and models (200)
GET {{baseUrl}}/vehicles?dealershipId={{dealershipId}}&make=Toyota&make=Honda&model=Corolla&model=Civic
X-Request-ID: {{$uuid}}
Accept: application/json

### Stock aged 90 days or less (200)
GET {{baseUrl}}/vehicles?dealershipId={{dealershipId}}&aging=false
X-Request-ID: {{$uuid}}
Accept: application/json

### Second page (200)
GET {{baseUrl}}/vehicles?dealershipId={{dealershipId}}&page=1&size=2
X-Request-ID: {{$uuid}}
Accept: application/json

### Available makes and models (200)
GET {{baseUrl}}/vehicle-filters?dealershipId={{dealershipId}}
X-Request-ID: {{$uuid}}
Accept: application/json

### Log a price reduction (200; increments rowVersion)
# Run the inventory request first and set @rowVersion to the current value.
# Omitting actionStatus defaults it to CREATED.
POST {{baseUrl}}/update-vehicle-status
X-Request-ID: {{$uuid}}
Content-Type: application/json

{
  "dealershipId": "{{dealershipId}}",
  "userId": "{{userId}}",
  "vehicleId": "{{vehicleId}}",
  "rowVersion": {{rowVersion}},
  "status": "PRICE_REDUCTION_PLANNED"
}

### Inspect the saved action and updated rowVersion (200)
GET {{baseUrl}}/vehicles?dealershipId={{dealershipId}}&make=Toyota&model=Corolla
X-Request-ID: {{$uuid}}
Accept: application/json

### Log maintenance in progress (200; refresh @rowVersion first)
POST {{baseUrl}}/update-vehicle-status
X-Request-ID: {{$uuid}}
Content-Type: application/json

{
  "dealershipId": "{{dealershipId}}",
  "userId": "{{userId}}",
  "vehicleId": "{{vehicleId}}",
  "rowVersion": {{rowVersion}},
  "status": "MAINTENANCE_PLANNED",
  "actionStatus": "IN_PROGRESS"
}

### Stale version (409 after at least one successful update of this vehicle)
POST {{baseUrl}}/update-vehicle-status
X-Request-ID: {{$uuid}}
Content-Type: application/json

{
  "dealershipId": "{{dealershipId}}",
  "userId": "{{userId}}",
  "vehicleId": "{{vehicleId}}",
  "rowVersion": 0,
  "status": "PRICE_REDUCTION_PLANNED"
}

### Unknown vehicle (404)
POST {{baseUrl}}/update-vehicle-status
X-Request-ID: {{$uuid}}
Content-Type: application/json

{
  "dealershipId": "{{dealershipId}}",
  "userId": "{{userId}}",
  "vehicleId": "00000000-0000-0000-0000-000000000999",
  "rowVersion": 0,
  "status": "PRICE_REDUCTION_PLANNED"
}

### Invalid pagination (400)
GET {{baseUrl}}/vehicles?dealershipId={{dealershipId}}&page=-1&size=0
X-Request-ID: {{$uuid}}
Accept: application/json

### Invalid action (400)
POST {{baseUrl}}/update-vehicle-status
X-Request-ID: {{$uuid}}
Content-Type: application/json

{
  "dealershipId": "{{dealershipId}}",
  "userId": "{{userId}}",
  "vehicleId": "{{vehicleId}}",
  "rowVersion": {{rowVersion}},
  "status": "INVALID_ACTION"
}
